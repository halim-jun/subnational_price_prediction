# Local dev (FastAPI mode) — copy to .env.local for local override
NEXT_PUBLIC_API_URL=http://localhost:8000

# Cloudflare prototype build mode — set to "true" only when running
#   NEXT_PUBLIC_STATIC_MODE=true npm run build
# (do NOT set during local dev unless you've also exported public/data/)
# NEXT_PUBLIC_STATIC_MODE=true

# The following two are NOT used by Next.js — they're set in Cloudflare Pages
# project settings (Environment variables) and consumed by functions/.
# Listed here for reference only.
#
# SITE_PASSWORD=change-me
# AUTH_SECRET=replace-with-32-byte-hex-from-openssl-rand-hex-32
